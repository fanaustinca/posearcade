#include <winver.h>
#include "version.h"  // written by build.ps1
1 ICON "..\\unbound.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Unbound - body-tracking games"
      VALUE "ProductName", "Unbound"
      VALUE "ProductVersion", VER_STRING
      VALUE "FileVersion", VER_STRING
      VALUE "OriginalFilename", "Unbound.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
